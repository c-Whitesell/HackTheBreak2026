{
  "name": "helloworld",
  "displayName": "HelloWorld",
  "description": "Sticky Pinned Functions for Hackathon",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "enabledApiProposals": [
    "editorInsets"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pin.function",
        "title": "Pin Code Snippet",
        "icon": "$(pin)"
      },
      {
        "command": "pin.unpinAll",
        "title": "Unpin Code Snippet",
        "icon": "$(pin)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pin.function",
          "group": "navigation",
          "when": "editorHasSelection"
        },
        {
          "command": "pin.unpinAll",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "sound-play": "^1.1.0"
  }
}
